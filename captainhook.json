{
    "config": {
        "verbosity": "normal",
        "fail-on-first-error": true
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "docker compose exec -T app vendor/bin/pint --test --dirty",
                "options": {
                    "fail-message": "Pint found style issues in staged files. Run: docker compose exec app vendor/bin/pint --dirty, then re-stage with git add."
                }
            }
        ]
    }
}
