APP_NAME=Podworko
APP_ENV=testing
APP_KEY=base64:Lz2j1YUdPXVXsdCVH26NB7J2/y6h0+Ws2YJf1VvmOXk=
APP_DEBUG=true
APP_URL=http://localhost
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=podworko_test_db
DB_USERNAME=podworko_user
DB_PASSWORD=podworko_123

# database (not array): array session lives only within a single request, so
# auth state is lost when the Codeception Laravel module follows a redirect into
# the next request. The DB session persists across requests via the kept cookie.
SESSION_DRIVER=database
# database (not array): the Codeception Laravel module re-inits the app per
# request, so array cache resets between requests and rate-limit counters never
# accumulate. The DB cache persists within a test's transaction.
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
